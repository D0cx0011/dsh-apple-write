{
  "name": "dsh-apple-write",
  "version": "0.3.0",
  "description": "让 AI 助手批量整理 iPhone 的提醒事项和通讯录（DeepSeek Harness 插件）。底层是 CalDAV VTODO / CardDAV vCard：批量写入、幂等重跑、真实闹钟(VALARM)，一个 App 专用密码覆盖两条通道。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "selftest.mjs",
    "probe.mjs",
    "live_probe.mjs"
  ],
  "scripts": {
    "test": "node selftest.mjs",
    "probe": "node probe.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "apple",
    "icloud",
    "caldav",
    "vtodo",
    "carddav",
    "reminders",
    "contacts",
    "todo"
  ],
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.1.5-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D0cx0011/dsh-apple-write.git"
  },
  "bugs": {
    "url": "https://github.com/D0cx0011/dsh-apple-write/issues"
  },
  "homepage": "https://github.com/D0cx0011/dsh-apple-write#readme",
  "license": "MIT"
}
